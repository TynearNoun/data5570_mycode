# Copy this file to .env. Django loads it on startup.
# Do not commit .env. Never commit the EC2 private key.

DJANGO_SECRET_KEY=change-me-before-you-host-this
DJANGO_DEBUG=true

# The class API host is the EC2 instance 13.56.184.13 (key pair data5570finalproject).
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=true

# SQLite is the default. For AWS RDS or Supabase Postgres, set the engine and
# connection fields and leave the sqlite file unused.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=rally
# DB_USER=rally
# DB_PASSWORD=
# DB_HOST=your-instance.rds.amazonaws.com
# DB_PORT=5432

# Optional proof-photo bucket. Without these, photos stay on the Django server.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION=us-west-1
